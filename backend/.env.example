# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example
#
# Copy this file to backend/.env and fill in the values.
# Never commit real credentials to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Prisma DATABASE_URL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Express server port
PORT=

# URL of the React frontend — used for the CORS whitelist.
# Development default: http://localhost:5173 (Vite dev server)
FRONTEND_URL=
